{
  "name": "ayscript",
  "displayName": "AYScript",
  "description": "AYScript language support with syntax highlighting",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ayscript.helloWorld",
        "title": "Hello World"
      }
    ],
    "languages": [
      {
        "id": "ayscript",
        "aliases": ["AYScript", "ayscript"],
        "extensions": [".ay", ".ays"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ayscript",
        "scopeName": "source.ayscript",
        "path": "./syntaxes/ayscript.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.104.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "eslint": "^9.34.0",
    "typescript": "^5.9.2",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MikeyA-yo/ayscript-ext"
  },
  "publisher": "AyomideEmmanuelOluwatola",
  "icon":"./media/ayscript.jpg",
  "license": "MIT"
}
